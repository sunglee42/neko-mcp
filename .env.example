# 127.0.0.1: local only. For LAN access, set the Docker host's actual LAN IPv4.
# Controls Neko HTTP, authenticated MCP, WebRTC port binding and advertised IP.
# Do not use 0.0.0.0: WebRTC needs a reachable address.
NEKO_IP=127.0.0.1
# IANA timezone; set explicitly to match the Docker host's timezone.
TZ=Asia/Taipei
NEKO_USER_PASSWORD=replace-with-random-password
NEKO_ADMIN_PASSWORD=replace-with-another-random-password
MCP_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
